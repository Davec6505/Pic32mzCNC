{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Open MikroC PIC32 Help",
            "type": "process",
            "command": "${env:WINDIR}\\hh.exe",
            "args": [
                "C:\\Users\\Public\\Documents\\Mikroelektronika\\mikroC PRO for PIC32\\mikroC_PRO_PIC32.chm"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build MikroC Project (External Terminal)",
            "type": "shell",
            "command": "start cmd /k \"cd /d ${workspaceFolder} && make && pause\"",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "never",
                "panel": "shared"
            }
        },
        {
            "label": "Search MikroC Defs",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-Command",
                "Select-String -Path \"C:\\Users\\Public\\Documents\\Mikroelektronika\\mikroC PRO for PIC32\\Defs\\P32MZ2048EFH100.cp\" -Pattern \"${input:searchTerm}\""
            ],
            "problemMatcher": []
        },
        {
            "label": "Clean Build Artifacts",
            "type": "shell",
            "command": "make clean",
            "problemMatcher": []
        },
        {
            "label": "Flash Device",
            "type": "shell",
            "command": "make flash",
            "problemMatcher": []
        }
    ],
    "inputs": [
    {
        "id": "searchTerm",
        "type": "promptString",
        "description": "Enter symbol to search for"
    }
]
}